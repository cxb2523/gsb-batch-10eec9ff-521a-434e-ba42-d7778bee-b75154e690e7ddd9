{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2020",
        "moduleResolution": "node",
        "sourceMap": false,
        "outDir": "../.test-build",
        "rootDir": "..",
        "types": ["node"],
        "lib": ["dom", "es2020"],
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": false,
        "strictNullChecks": false,
        "noImplicitAny": false
    },
    "include": ["./**/*.ts", "../src/**/*.ts"]
}
